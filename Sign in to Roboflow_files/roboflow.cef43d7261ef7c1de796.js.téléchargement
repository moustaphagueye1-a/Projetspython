ence__core__workflows__core_steps__transformations__qr_code_generator__v1__BlockManifest":{"block_type":"transformation","license":"Apache-2.0","long_description":"\\nGenerate a QR code image from a string input (typically a URL).\\n\\nThis block creates a QR code PNG image from the provided text input. It supports \\nvarious customization options including size control, error correction levels, \\nand visual styling. The generated QR code can be used in workflows where you need \\nto create QR codes for URLs, text content, or other data that needs to be encoded.\\n\\nThe output is a PNG image that can be passed to other workflow blocks such as \\nvisualizers or image processing blocks.\\n","name":"QR Code Generator","properties":{"type":{"enum":["roboflow_core/qr_code_generator@v1","QRCodeGenerator"],"title":"Type","type":"string"},"name":{"description":"Enter a unique identifier for this step.","title":"Step Name","type":"string"},"text":{"anyOf":[{"type":"string"},{"kind":[{"description":"String value","docs":"\\nExamples:\\n```\\n\\"my string value\\"\\n```\\n","internal_data_type":"str","name":"string","serialised_data_type":"str"}],"pattern":"(^\\\\$steps\\\\.[A-Za-z_\\\\-0-9]+\\\\.[A-Za-z_*0-9\\\\-]+$)|(^\\\\$inputs.[A-Za-z_0-9\\\\-]+$)","reference":true,"selected_element":"any_data","selector_points_to_batch":"dynamic","type":"string"}],"description":"Text or URL to encode in the QR code","examples":["https://roboflow.com","$inputs.url","Hello World"],"title":"Text"},"error_correct":{"default":"Medium (~15% word recovery)","description":"Increased error correction comes at the expense of data capacity (text length). Use higher error correction if the QR code is likely to be transformed or obscured, but use a lower error correction level if the URL is long and the QR code is clearly visible.","enum":["Low (~7% word recovery / highest data capacity)","Medium (~15% word recovery)","Quartile (~25% word recovery)","High (~30% word recovery / lowest data capacity)